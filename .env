# Copy this file to ".env" (same folder as server.js) and fill in real values.
# The ".env" file itself should NEVER be committed to git or shared publicly.
# (Database connection settings still live in the DB_CONFIG object at the
# top of server.js — edit that directly if your MySQL setup differs.)

# ---- App ----
PORT=5000
JWT_SECRET=change-this-to-a-long-random-string
APP_URL=http://localhost:5000

# ---- Email (required for real "forgot password" emails) ----
# Example values below are for Gmail. For Gmail you must use an "App Password",
# not your normal Gmail password:
#   1. Turn on 2-Step Verification: https://myaccount.google.com/security
#   2. Create an App Password: https://myaccount.google.com/apppasswords
#   3. Use that 16-character password as SMTP_PASS below.
#
# Any other provider (Outlook, Yahoo, SendGrid, Mailgun, your host's SMTP, etc.)
# works too — just use the host/port/credentials they give you.

# Gmail example (use a Google App Password, not your normal Gmail password)
SMTP_SERVICE=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=dullare204@gmail.com
SMTP_PASS=jwsboerczosunxlo
SMTP_FROM=dullare204@gmail.com


HELLO="Dotenv"
OPENAI_API_KEY="your-api-key-goes-here"